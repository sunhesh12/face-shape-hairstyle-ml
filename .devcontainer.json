{
    "name": "Face Shape Predictor Container",
    "image": "ubuntu:22.04",
    "runArgs": [
        "--privileged",
        "--network=host"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "eamodio.gitlens"
            ]
        }
    },
    // Added to mount the local project folder into the container:
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/face-shape-hairstyle-ml,type=bind",
    // Set the default folder VS Code opens inside the container:    
    "workspaceFolder": "/workspaces/face-shape-hairstyle-ml"
}